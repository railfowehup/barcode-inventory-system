<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Logo / Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦"
            android:textSize="64sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="包裹入库系统"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请输入您的姓名开始使用"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- 服务器地址 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务器地址"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"
            android:layout_gravity="start" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="例如: http://192.168.38.62:3000"
            android:text="http://192.168.38.62:3000"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 姓名输入 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="您的姓名"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"
            android:layout_gravity="start" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="例如: 张三"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/edittext_bg"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- 登录按钮 -->
        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="进入系统"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3" />

        <!-- 扫码连接按钮 -->
        <Button
            android:id="@+id/scanQrBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📷 扫码连接服务器"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00BCD4"
            android:layout_marginTop="12dp" />

        <!-- 离线体验按钮 -->
        <Button
            android:id="@+id/offlineBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📴 离线体验"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:backgroundTint="#333333"
            android:layout_marginTop="12dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="20dp" />

        <!-- 启动手机服务器按钮 -->
        <Button
            android:id="@+id/startServerBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📡 启动手机服务器"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp" />

        <!-- 同步按钮 -->
        <Button
            android:id="@+id/syncBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 数据同步"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="8dp" />

        <!-- 备份按钮 -->
        <Button
            android:id="@+id/backupBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="💾 备份/恢复"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9C27B0"
            android:layout_marginBottom="8dp" />

        <!-- 设备ID显示 -->
        <TextView
            android:id="@+id/deviceIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备ID: 获取中..."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- 服务器状态 -->
        <TextView
            android:id="@+id/serverStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- 服务器二维码 -->
        <ImageView
            android:id="@+id/serverQrImage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:contentDescription="服务器二维码" />

        <!-- 状态信息 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF5252"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
