{
  "name": "barcode-server",
  "version": "1.0.0",
  "description": "📦 包裹入库管理系统 - 桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "cap:init": "npx @capacitor/cli init \"包裹手机\" com.barcodescanner.mobile --web-dir=public",
    "cap:add-android": "npx cap add android",
    "cap:open-android": "npx cap open android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync"
  },
  "build": {
    "appId": "com.barcodescanner.server",
    "productName": "包裹管理系统",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "package.json",
      "dashboard/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "${productName}-${version}-便携版.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-便携版.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": "包裹管理系统-数据"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "包裹管理系统"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chart.js": "^4.4.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.4",
    "@capacitor/cli": "^5.0.4",
    "@capacitor/core": "^5.0.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
